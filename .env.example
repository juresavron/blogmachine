# Optional local configuration. Copy to .env and restart the server.
# Never commit .env or credentials.
PORT=3001
DATABASE_PATH=./data/blogmachine.sqlite

# For a website with the credential prefix MY_WEBSITE:
# MY_WEBSITE_URL=https://yourwebsite.com
# MY_WEBSITE_USERNAME=
# MY_WEBSITE_APPLICATION_PASSWORD=

# Optional Google OAuth access token (short-lived, refresh externally).
# Needs property access and https://www.googleapis.com/auth/webmasters scope.
# GOOGLE_ACCESS_TOKEN=

# Repository connections use sibling checkouts under /workspace by default.
# BLOGMACHINE_REPOSITORIES_ROOT=/workspace

# Hosted OcenaGor family source: fine-grained GitHub token with Contents: read
# for juresavron/ocenagor-landing-lovable-13. Server/runtime only, never VITE_.
# Existing GITHUB_TOKEN can also be used. Local verified checkouts need no token.
# BLOGMACHINE_GITHUB_TOKEN=

# Mediašped: public project URL/key are read from its fixed source checkout.
# Normal setup: Repository connections -> Mediašped -> Connect account.
# Sign in with an existing Mediašped administrator account; no token is needed here.
# Sessions refresh automatically in server memory. Reconnect after a server restart
# or the eight-hour session limit. Disconnect ends this browser's connection.
# Optional headless fallback only: a raw signed-in administrator access JWT.
# This fallback expires and must be refreshed externally. No service-role keys.
# MEDIASPED_SUPABASE_ACCESS_TOKEN=
# Optional public configuration overrides:
# MEDIASPED_SUPABASE_URL=https://ytmowbzkpofeeocgevyr.supabase.co
# MEDIASPED_SUPABASE_ANON_KEY=

# Trgovina: public config is read from its source; admin test is optional.
# TRGOVINA_SUPABASE_ACCESS_TOKEN=
# TRGOVINA_SUPABASE_URL=https://cybwzhgretztcjfdefoy.supabase.co
# TRGOVINA_SUPABASE_ANON_KEY=
