{
  "name": "blogmachine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test server/*.test.ts server/repositories/*.test.ts server/hosted/*.test.ts",
    "build:hosted": "tsc --noEmit && tsc -p tsconfig.hosted.json --noEmit && vite build && node scripts/build-hosted.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.166.0"
  }
}
